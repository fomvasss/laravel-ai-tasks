{
  "name": "fomvasss/laravel-ai-tasks",
  "description": "AI task orchestrator for Laravel: routing, queue, audit, budget, webhooks",
  "type": "library",
  "license": "MIT",
  "funding": [
    {
      "type": "custom",
      "url": "https://send.monobank.ua/jar/5xsqtHvVrY"
    },
    {
      "type": "ko_fi",
      "url": "https://ko-fi.com/fomvasss"
    }
  ],
  "keywords": ["laravel", "ai", "llm", "queue", "openai", "gemini", "anthropic", "ollama", "orchestrator"],
  "authors": [
    {
      "name": "fomvasss",
      "email": "fomvasss@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/support": "^12.0|^13.0",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/queue": "^12.0|^13.0",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/events": "^12.0|^13.0",
    "illuminate/pipeline": "^12.0|^13.0",
    "illuminate/http": "^12.0|^13.0",
    "laravel/ai": "^0.11"
  },
  "suggest": {
    "laravel/mcp": "Native MCP client support (recommended over HttpMcpClient for production use)"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Fomvasss\\AiTasks\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Fomvasss\\AiTasks\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Fomvasss\\AiTasks\\AiServiceProvider"
      ],
      "aliases": {
        "AI": "Fomvasss\\AiTasks\\Facades\\AI"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
